# Safe repository defaults. A local .env overrides these values.
STORAGE_PROVIDER=local
SOURCE_URI=local://storage/input
TARGET_URI=local://storage/output
SOURCE_LANG=es
TARGET_LANG=en
LOG_LEVEL=INFO

WHISPER_MODEL=auto
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_BEAM_SIZE=5
WHISPER_CONDITION_ON_PREVIOUS_TEXT=true
WHISPER_INITIAL_PROMPT=Tai Chi, taichi, Tai Chi Chuan, Taijiquan, T'ai Chi, qi, qigong, chi kung, yin yang, wuji, baguazhang, Xing Yi, Tui Shou, Qin Na, Chin Na, Lan Que Wei, Si Zheng Tui, Peng, Lu, Ji, An, Cai, Lie, Zhou, Kao, taiji, taijiquan, manos de seda, gran rueda, tambor chino, cielo, tierra, Tao, tai chi, tai-chi, Taiji, forma, formas, postura, posturas, posición, posiciones, movimiento, movimientos, estructura, quietud, raíz, enraizamiento, centro, equilibrio, relajación, tensión, respiración, cintura, cadera, pelvis, columna, espalda, hombros, codos, muñecas, manos, dedos, piernas, rodillas, tobillos, pies
WHISPER_CPU_THREADS=0
WHISPER_REPETITION_THRESHOLD=0.60
WHISPER_COMPRESSION_RATIO_THRESHOLD=2.4
WHISPER_LOG_PROB_THRESHOLD=-1.0
WHISPER_NO_SPEECH_THRESHOLD=0.6
WHISPER_MIN_REPETITION_WORDS=8
WHISPER_RECOVERY_RETRIES=1
WHISPER_RECOVERY_TEMPERATURES=0.2

TRANSLATION_PROVIDER=mistral
TRANSLATION_FALLBACK_PROVIDERS=local,deepl,mymemory
TRANSLATION_RETRIES=3
TRANSLATION_MAX_RETRIES_PER_PROVIDER=3
TRANSLATION_BATCH_SIZE=25
TRANSLATION_RETRY_DELAY_SECONDS=1.5
TRANSLATION_MIN_REQUEST_INTERVAL_SECONDS=0.5
TRANSLATION_MAX_BACKOFF_SECONDS=16
TRANSLATION_MAX_PARALLEL_REQUESTS=2
TRANSLATION_PROVIDER_MAX_PARALLEL_REQUESTS=0

# Optional offline local translation. The pinned model must be prepared explicitly.
LOCAL_TRANSLATION_MODEL_DIR=tools/models/translation/opus-mt-es-en-ct2-int8
LOCAL_TRANSLATION_MODEL_ID=Prukario/opus-mt-es-en-ct2-int8
LOCAL_TRANSLATION_MODEL_REVISION=ad91ad1697ea1761111ff4c179400796d085b347
LOCAL_TRANSLATION_DEVICE=auto
LOCAL_TRANSLATION_COMPUTE_TYPE=auto
LOCAL_TRANSLATION_BEAM_SIZE=2
LOCAL_TRANSLATION_AUTO_DOWNLOAD=false

# Optional provider credentials. Keep real keys in .env, never in Git.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
DEEPL_API_KEY=
MYMEMORY_EMAIL=
GOOGLE_TRANSLATE_API_KEY=
MICROSOFT_TRANSLATOR_API_KEY=
MICROSOFT_TRANSLATOR_REGION=

MAX_PARALLEL_VIDEOS=0
FFMPEG_AVOID_REENCODE=true
FFMPEG_BIN=
GOOGLE_PROFILE=default
RCLONE_REMOTE=remote_drive
RCLONE_BINARY_FILE=tools/rclone/rclone
RCLONE_CONFIG_FILE=secrets/rclone/rclone.conf
PROVIDER_PROFILE_DIR=secrets/providers
GENERATE_WEBM=true

# Safe repository defaults. A local .env overrides these values.
STORAGE_PROVIDER=local
SOURCE_URI=local://storage/input
TARGET_URI=local://storage/output
SOURCE_LANG=es
TARGET_LANG=en
LOG_LEVEL=INFO

WHISPER_MODEL=auto
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_CONDITION_ON_PREVIOUS_TEXT=true
WHISPER_INITIAL_PROMPT=Tai Chi, taichi, Tai Chi Chuan, Taijiquan, T'ai Chi, qi, qigong, chi kung, yin yang, wuji, baguazhang, Xing Yi, Tui Shou, Qin Na, Chin Na, Lan Que Wei, Si Zheng Tui, Peng, Lu, Ji, An, Cai, Lie, Zhou, Kao, taiji, taijiquan, manos de seda, gran rueda, tambor chino, cielo, tierra
WHISPER_CPU_THREADS=0
TRANSLATION_PROVIDER=google
TRANSLATION_FALLBACK_PROVIDERS=mymemory
TRANSLATION_RETRIES=5
TRANSLATION_MAX_RETRIES_PER_PROVIDER=5
TRANSLATION_BATCH_SIZE=0
TRANSLATION_RETRY_DELAY_SECONDS=1.5
TRANSLATION_MIN_REQUEST_INTERVAL_SECONDS=0.35
TRANSLATION_MAX_BACKOFF_SECONDS=16

# Optional providers. Leave empty unless credentials are deliberately configured.
MICROSOFT_TRANSLATOR_API_KEY=
LIBRETRANSLATE_API_KEY=
LIBRETRANSLATE_URL=

MAX_PARALLEL_VIDEOS=0
FFMPEG_AVOID_REENCODE=true
FFMPEG_BIN=
GOOGLE_PROFILE=default
RCLONE_REMOTE=remote_drive
RCLONE_BINARY_FILE=tools/rclone/rclone
RCLONE_CONFIG_FILE=secrets/rclone/rclone.conf
PROVIDER_PROFILE_DIR=secrets/providers
GENERATE_WEBM=true

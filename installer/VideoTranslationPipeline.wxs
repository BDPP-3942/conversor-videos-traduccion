<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Video Translation Pipeline"
      Manufacturer="BDPP-3942"
      Version="$(var.Version)"
      UpgradeCode="238C5442-0D95-48C3-B2AF-801CE5B1C7CB">
    <MajorUpgrade DowngradeErrorMessage="Ya existe una versión más reciente de Video Translation Pipeline." />
    <MediaTemplate EmbedCab="yes" />
    <Feature Id="MainFeature" Title="Video Translation Pipeline" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="ApplicationShortcuts" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="VideoTranslationPipeline" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Video Translation Pipeline" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.SourceDir)\**" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <Component Id="ApplicationShortcuts" Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut
          Id="ApplicationStartMenuShortcut"
          Name="Video Translation Pipeline"
          Description="Aplicación de escritorio para Video Translation Pipeline"
          Target="[INSTALLFOLDER]VideoTranslationPipeline.exe"
          WorkingDirectory="INSTALLFOLDER" />
      <Shortcut
          Id="UninstallProduct"
          Name="Desinstalar Video Translation Pipeline"
          Description="Desinstala Video Translation Pipeline y conserva los datos del usuario"
          Target="[SystemFolder]msiexec.exe"
          Arguments="/x [ProductCode]" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryKey
          Root="HKCU"
          Key="Software\BDPP-3942\VideoTranslationPipeline"
          ForceDeleteOnUninstall="yes">
        <!-- Windows Installer necesita este valor como KeyPath para el componente de accesos directos no anunciados. -->
        <RegistryValue Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </RegistryKey>
    </Component>
  </Fragment>
</Wix>

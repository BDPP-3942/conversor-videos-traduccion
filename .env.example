# Copy to .env only if you want local overrides. .env.default is loaded automatically otherwise.
STORAGE_PROVIDER=local
SOURCE_URI=local://storage/input
TARGET_URI=local://storage/output
SOURCE_LANG=es
TARGET_LANG=en
LOG_LEVEL=INFO

WHISPER_MODEL=auto
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_BEAM_SIZE=5
WHISPER_CONDITION_ON_PREVIOUS_TEXT=true
WHISPER_MIN_SILENCE_DURATION_MS=1500
WHISPER_CPU_THREADS=0

# Translation: Mistral -> Local CTranslate2 -> DeepL -> MyMemory.
TRANSLATION_PROVIDER=mistral
TRANSLATION_FALLBACK_PROVIDERS=local,deepl,mymemory
TRANSLATION_RETRIES=3
TRANSLATION_MAX_RETRIES_PER_PROVIDER=3
TRANSLATION_BATCH_SIZE=25
TRANSLATION_RETRY_DELAY_SECONDS=1.5
TRANSLATION_MIN_REQUEST_INTERVAL_SECONDS=0.5
TRANSLATION_MAX_BACKOFF_SECONDS=16
TRANSLATION_MAX_PARALLEL_REQUESTS=2
# 0 = use the conservative provider-specific defaults.
TRANSLATION_PROVIDER_MAX_PARALLEL_REQUESTS=0

# Offline local translation. The model must be prepared explicitly before offline processing.
LOCAL_TRANSLATION_MODEL_DIR=tools/models/translation/opus-mt-es-en-ct2-int8
LOCAL_TRANSLATION_MODEL_ID=Prukario/opus-mt-es-en-ct2-int8
LOCAL_TRANSLATION_MODEL_REVISION=ad91ad1697ea1761111ff4c179400796d085b347
LOCAL_TRANSLATION_DEVICE=auto
LOCAL_TRANSLATION_COMPUTE_TYPE=auto
LOCAL_TRANSLATION_BEAM_SIZE=2
LOCAL_TRANSLATION_AUTO_DOWNLOAD=false

# Provider credentials. Keep real secrets in .env and never in Git.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
DEEPL_API_KEY=
MYMEMORY_EMAIL=
GOOGLE_TRANSLATE_API_KEY=
MICROSOFT_TRANSLATOR_API_KEY=
MICROSOFT_TRANSLATOR_REGION=

MAX_PARALLEL_VIDEOS=0
AUTOMATIC_OUTPUT_DEDUPLICATION=false
FFMPEG_AVOID_REENCODE=true
FFMPEG_BIN=
GOOGLE_PROFILE=default
RCLONE_REMOTE=remote_drive
RCLONE_BINARY_FILE=tools/rclone/rclone
RCLONE_CONFIG_FILE=secrets/rclone/rclone.conf
PROVIDER_PROFILE_DIR=secrets/providers
GENERATE_WEBM=true

# Optional synchronized TTS. Disabled by default.
TTS_ENABLED=false
TTS_REQUIRED=false
TTS_PROVIDER=kokoro
TTS_VOICE=af_sarah
TTS_MODEL_PATH=tools/tts/kokoro-v1.0.onnx
TTS_VOICES_PATH=tools/tts/voices-v1.0.bin
TTS_SPEED=1.0
TTS_MAX_SPEED=1.35
TTS_DURATION_TOLERANCE=0.02
TTS_SAMPLE_RATE=24000
TTS_AUDIO_BITRATE=192k
TTS_WEBM_AUDIO_BITRATE=192k
TTS_GENERATE_WEBM=true

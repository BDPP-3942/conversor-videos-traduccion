STORAGE_PROVIDER=local
SOURCE_URI=local://storage/input
TARGET_URI=local://storage/output
SOURCE_LANG=es
TARGET_LANG=en
LOG_LEVEL=INFO

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
WHISPER_CONDITION_ON_PREVIOUS_TEXT=false
WHISPER_CPU_THREADS=0
TRANSLATION_PROVIDER=google
TRANSLATION_FALLBACK_PROVIDERS=microsoft,libretranslate
TRANSLATION_RETRIES=5
TRANSLATION_MAX_RETRIES_PER_PROVIDER=5
TRANSLATION_BATCH_SIZE=40
TRANSLATION_RETRY_DELAY_SECONDS=1.5
TRANSLATION_MIN_REQUEST_INTERVAL_SECONDS=0.35
TRANSLATION_MAX_BACKOFF_SECONDS=16
MICROSOFT_TRANSLATOR_API_KEY=
MAX_PARALLEL_VIDEOS=2
FFMPEG_AVOID_REENCODE=true
FFMPEG_BIN=

GOOGLE_PROFILE=default
RCLONE_REMOTE=remote_drive
RCLONE_BINARY_FILE=tools/rclone/rclone
RCLONE_CONFIG_FILE=secrets/rclone/rclone.conf
PROVIDER_PROFILE_DIR=secrets/providers

# Duplicate detection: name is only a candidate; media characteristics decide whether to skip.
DUPLICATE_NAME_SIMILARITY_THRESHOLD=0.82
DUPLICATE_DURATION_TOLERANCE_SECONDS=1.5
DUPLICATE_VISUAL_SIMILARITY_THRESHOLD=0.91

# Lightweight secondary video output
SECONDARY_VIDEO_EXTENSION=webm
SECONDARY_VIDEO_CODEC=libvpx-vp9
SECONDARY_VIDEO_CRF=0
SECONDARY_VIDEO_MAX_WIDTH=0
SECONDARY_VIDEO_FPS=0
SECONDARY_VIDEO_AUDIO_CODEC=libopus
SECONDARY_VIDEO_AUDIO_BITRATE=256k
SECONDARY_VIDEO_CPU_USED=5
RENAME_PROCESSED_DUPLICATES=true

# Secondary WebM output (true by default)
GENERATE_WEBM=true
